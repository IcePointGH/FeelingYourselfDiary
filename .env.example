# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/emotion_diary?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_password_here

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USERNAME=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_ACCESS_KEY=your_access_key_here
MINIO_SECRET_KEY=your_secret_key_here

# JWT Configuration
JWT_SECRET=your_secret_key_at_least_32_chars
JWT_EXPIRATION=86400000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# CORS Configuration
# 本地开发: http://localhost:3000
# IP-only 部署: http://你的服务器IP
# 域名部署: https://你的域名
# ⚠ 不能填 * —— 和 allowCredentials=true 冲突导致浏览器拒绝
CORS_ORIGINS=http://localhost:3000

# DeepSeek AI (可选 — 不设置则 AI 对话/分析功能不可用)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
