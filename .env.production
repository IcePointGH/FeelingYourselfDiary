# ===== 数据库 =====
DB_USERNAME=root
DB_PASSWORD=your_secure_database_password_here

# ===== JWT =====
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRATION=86400000

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===== MinIO 对象存储 =====
MINIO_ROOT_USERNAME=minioadmin
MINIO_ROOT_PASSWORD=your_minio_admin_password_here

# ===== CORS — 必须设置为客户端实际访问的 origin =====
# IP-only 部署：http://你的服务器IP
# 域名部署：https://你的域名
# ⚠ 不能填 * —— 和 credentials 冲突会导致浏览器拒绝 CORS
CORS_ORIGINS=http://localhost

# ===== DeepSeek AI (可选 — 不设置则 AI 功能不可用) =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here
